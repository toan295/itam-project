{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=itam_db;User=root;Password=YOUR_MYSQL_PASSWORD;"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_BYTES",
    "Issuer": "EAIMS.API",
    "Audience": "EAIMS.Client",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  }
}
