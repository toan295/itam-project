{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=itam_db;User=root;Password=YOUR_MYSQL_PASSWORD;"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_BYTES",
    "Issuer": "EAIMS.API",
    "Audience": "EAIMS.Client",
    "ExpiryMinutes": 5256000
  },
  "Email": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "your-account@gmail.com",
    "Password": "APP_PASSWORD_NOT_YOUR_REAL_PASSWORD",
    "FromAddress": "your-account@gmail.com",
    "FromName": "EAIMS",
    "FrontendBaseUrl": "http://localhost:5500",
    "ActivationValidDays": 3
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  },
  "Backup": {
    "Directory": "App_Data/Backups",
    "MysqlBinPath": ""
  }
}
