Table Employees {
  Id int [pk, increment]
  EmployeeCode varchar(20) [not null, note: 'NV0001... sinh tu dong theo Id; duy nhat qua ActiveEmployeeCode']
  FullName varchar(100) [not null]
  DepartmentId int [not null]
  Position varchar(100) [note: 'Chuc danh']
  Email varchar(150) [note: 'email nhan thu xac nhan thong tin ca nhan; null = nhan vien cu chua bo sung']
  Phone varchar(20) [note: 'so dien thoai da chuan hoa']
  UserId int [unique, note: 'tai khoan dang nhap (vai tro Employee) cua nhan vien; null = chua cap']
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  IsDeleted boolean [not null, default: false, note: 'xoa mem']
  DeletedAt datetime
  ActiveEmployeeCode varchar(20) [unique, note: 'cot sinh tu dong: EmployeeCode neu chua xoa']
  ActiveDeptFullName varchar(120) [unique, note: 'cot sinh tu dong: DepartmentId|FullName neu chua xoa (duy nhat trong phong ban)']

  indexes {
    DepartmentId
    FullName
  }

  Note: 'Danh muc nhan vien nhan tai san; nguoi nhan khi phan bo phai chon tu day (khong phai tai khoan dang nhap)'
}

Table DisposalStatuses {
  Id int [pk, increment]
  Code varchar(50) [not null, note: 'Inspected|Proposed|Approved|Rejected|Completed (he thong) hoac custom-xxxx (Admin them)']
  Name varchar(100) [not null]
  IsDeleted boolean [not null, default: false, note: 'xoa mem']
  DeletedAt datetime
  ActiveCode varchar(50) [unique, note: 'cot sinh tu dong: Code neu chua xoa']
  ActiveName varchar(100) [unique, note: 'cot sinh tu dong: Name neu chua xoa']
  Description varchar(255)
  Color varchar(20) [not null, note: 'success|warning|danger|info|slate']
  SortOrder int [not null]
  IsSystem boolean [not null, note: 'true = buoc chinh cua luong (khong xoa duoc, Code bat bien); false = trang thai phu do Admin them']

  Note: 'Danh muc trang thai phieu thanh ly, Admin IT them/sua/xoa. 5 dong he thong co san trong migration.'
}

Table DisposalRequests {
  Id int [pk, increment]
  AssetId int [not null]
  StatusId int [not null, note: 'Buoc hien tai cua luong (luon la trang thai he thong)']
  SubStatusId int [note: 'Trang thai phu Admin IT gan thu cong (IsSystem = false)']
  InspectionNote varchar(2000) [not null]
  InspectedByUserId int [not null]
  InspectedAt datetime [not null]
  Reason varchar(1000)
  DisposalMethod varchar(100)
  ProposedByUserId int
  ProposedAt datetime
  ReviewNote varchar(1000)
  ReviewedByUserId int
  ReviewedAt datetime
  CompletionNote varchar(1000)
  CompletedByUserId int
  CompletedAt datetime
  CreatedAt datetime [not null]

  indexes {
    AssetId
    StatusId
    SubStatusId
    ActiveAssetId int [unique, note: '= AssetId khi phieu con dang xu ly, NULL khi ket thuc (Tu choi/Hoan tat); unique => moi tai san toi da 1 phieu dang mo']
}

  Note: 'Luong: Technician kiem tra -> de xuat -> Manager duyet/tu choi -> Admin IT thanh ly -> hoan tat'
}

Ref: Users.RoleId > Roles.Id
Ref: Users.DepartmentId > Departments.Id
Ref: AssetCategoryLifecyclePolicies.CategoryId > AssetCategories.Id
Ref: Assets.CategoryId > AssetCategories.Id
Ref: Assets.DepartmentId > Departments.Id
Ref: AssetSoftwareLicenses.AssetId > Assets.Id
Ref: AssetSoftwareLicenses.LicenseId > SoftwareLicenses.Id
Ref: MaintenanceTickets.AssetId > Assets.Id
Ref: MaintenanceTickets.TechnicianId > Users.Id
Ref: AssetAllocations.AssetId > Assets.Id
Ref: AssetAllocations.DepartmentId > Departments.Id
Ref: AuditLogs.UserId > Users.Id
// Ref: BudgetForecasts.DepartmentId > Departments.Id
// Ref: AssetCategoryReferencePrices.CategoryId - AssetCategories.Id
// Ref: DepartmentExpansionPlans.DepartmentId > Departments.Id
// Ref: AssetCategoryDeviceRatios.CategoryId - AssetCategories.Id

Ref: DisposalRequests.AssetId > Assets.Id
Ref: DisposalRequests.StatusId > DisposalStatuses.Id
Ref: DisposalRequests.SubStatusId > DisposalStatuses.Id
Ref: DisposalRequests.InspectedByUserId > Users.Id
Ref: DisposalRequests.ProposedByUserId > Users.Id
Ref: DisposalRequests.ReviewedByUserId > Users.Id
Ref: DisposalRequests.CompletedByUserId > Users.Id

Table RolePermissions {
  RoleId int [not null, note: 'vai tro duoc cap quyen']
  PermissionCode varchar(80) [not null, note: 'ma quyen trong PermissionCatalog (vd assets.create); danh muc quyen nam o code']
  indexes {
    (RoleId, PermissionCode) [pk]
  }
  Note: 'Ma tran phan quyen vai tro x chuc nang, chinh duoc tren giao dien Phan quyen. Employee bi khoa (khong sua).'
}

Table AccountActivations {
  Id int [pk, increment]
  UserId int [not null, note: 'tai khoan nhan vien cho kich hoat']
  TokenHash varchar(64) [not null, unique, note: 'SHA-256 cua token trong email (khong luu token goc)']
  EmailTo varchar(150) [not null, note: 'dia chi da gui toi']
  Reason varchar(30) [not null, note: 'Created | Resent | Reset']
  Status tinyint [not null, note: '0 Pending | 1 Activated | 2 Superseded']
  CreatedAt datetime [not null]
  ExpiresAt datetime [not null, note: 'mac dinh 3 ngay (Email:ActivationValidDays)']
  SentAt datetime [note: 'null = chua gui duoc (xem SendError)']
  SendError varchar(500)
  ActivatedAt datetime
  indexes {
    (UserId, CreatedAt)
  }
  Note: 'Lien ket kich hoat / dat lai mat khau: nguoi dung bam lien ket va tu dat mat khau (khong co mat khau mac dinh).'
}

Ref: AccountActivations.UserId > Users.Id [delete: cascade]
Ref: RolePermissions.RoleId > Roles.Id [delete: cascade]
Ref: Employees.DepartmentId > Departments.Id
Ref: Employees.UserId - Users.Id
Ref: MaintenanceTickets.ReportedByUserId > Users.Id
Ref: AssetAllocations.EmployeeId > Employees.Id
Ref: AssetAllocations.HandedOverByUserId > Users.Id
Ref: AssetAllocations.ReceivedByUserId > Users.Id

Ref: MaintenanceTicketHistories.TicketId > MaintenanceTickets.Id [delete: cascade]
