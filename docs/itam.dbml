Project EAIMS {
  database_type: 'MySQL'
  Note: 'Enterprise IT Asset & Infrastructure Management System - ERD'
}

Table Roles {
  Id int [pk, increment]
  Name varchar(50) [not null, unique, note: 'Admin IT, Manager, Technician']
}

Table Departments {
  Id int [pk, increment]
  Name varchar(100) [not null]
  Description varchar(255)
  IsDeleted boolean [not null, default: false, note: 'xoa mem: bam Xoa tren giao dien chi danh dau, dong van con trong CSDL']
  DeletedAt datetime
  ActiveName varchar(100) [unique, note: 'cot sinh tu dong (Name neu chua xoa, nguoc lai NULL) de tao lai cung ten sau khi xoa mem']
}

Table Users {
  Id int [pk, increment]
  FullName varchar(100) [not null]
  Email varchar(150) [not null, unique]
  Phone varchar(20) [note: 'so dien thoai da chuan hoa, nullable (tai khoan cu)']
  PasswordHash varchar(255) [not null]
  RoleId int [not null]
  DepartmentId int [not null]
  IsActive boolean [not null, default: true]
  MustChangePassword boolean [not null, default: false, note: 'true chi voi Admin IT dau tien tao tu cau hinh Bootstrap - bat buoc doi mat khau truoc khi dung he thong']
  PendingActivation bool [not null, default: false, note: 'tai khoan moi tao hoac vua duoc Admin dat lai mat khau: cho nguoi dung bam lien ket va tu dat mat khau; chua dang nhap duoc']
  IsDeleted boolean [not null, default: false, note: 'xoa mem: giu dong de nhat ky/phieu con ten nguoi thuc hien; email doi thanh deleted.{id}.{time}@deleted.invalid']
  DeletedAt datetime
  CreatedAt datetime [not null, default: `now()`]

  indexes {
    RoleId
    DepartmentId
  }
}

Table AssetCategories {
  Id int [pk, increment]
  Name varchar(100) [not null, note: 'may tinh, man hinh, may in, switch/router, thiet bi luu tru...']
  IsDeleted boolean [not null, default: false, note: 'xoa mem']
  DeletedAt datetime
  ActiveName varchar(100) [unique, note: 'cot sinh tu dong: Name neu chua xoa, nguoc lai NULL']
}

Table AssetCategoryLifecyclePolicies {
  Id int [pk, increment]
  CategoryId int [not null, unique]
  MaxAgeYears int [not null, note: 'Nguong tuoi toi da theo loai tai san']
  MaxFailureCount int [not null, note: 'Nguong tong so phieu bao tri (moi trang thai) theo loai tai san']
  Version int [not null, default: 1, note: 'Optimistic concurrency, tu tang moi lan sua; client gui lai khi sua/xoa (409 neu lech)']
  UpdatedAt datetime(6) [null, note: 'UTC; null = dong co truoc khi theo doi']
  UpdatedByUserId int [null, note: 'Nguoi tao/sua gan nhat (khong co FK, ten lay tu Users)']

  Note: 'Chi luu nguong override. Loai khong co dong rieng se dung LifecycleOptions trong appsettings.json'
}

Table Assets {
  Id int [pk, increment]
  AssetCode varchar(50) [not null, unique]
  Name varchar(150) [not null]
  CategoryId int [not null]
  SerialNumber varchar(100)
  Specification varchar(500)
  OperatingSystem varchar(100)
  DepartmentId int [not null]
  Status tinyint [not null, note: '0=InUse,1=Maintenance,2=Broken,3=Disposed']
  PurchaseDate date
  WarrantyExpiry date
  CreatedAt datetime [not null, default: `now()`]

  indexes {
    CategoryId
    DepartmentId
    Status
    Version int [not null, default: 1, note: 'so phien ban - tu tang moi lan sua; client gui lai de chong ghi de (409)']
}
}

Table SoftwareLicenses {
  Id int [pk, increment]
  SoftwareName varchar(150) [not null]
  LicenseKey varchar(255) [not null]
  ExpiryDate date [not null]
  MaxUsage int [not null]
  Notes varchar(500)
  IsDeleted boolean [not null, default: false, note: 'xoa mem']
  DeletedAt datetime
  ActiveLicenseKey varchar(255) [unique, note: 'cot sinh tu dong: LicenseKey neu chua xoa, nguoc lai NULL']

  indexes {
    ExpiryDate
  }

  Note: 'CurrentUsage KHONG luu cot rieng - tinh bang COUNT(AssetSoftwareLicenses) de tranh lech du lieu'
}

Table AssetSoftwareLicenses {
  Id int [pk, increment]
  AssetId int [not null]
  LicenseId int [not null]
  AssignedDate date [not null]

  indexes {
    (AssetId, LicenseId) [unique, note: 'tranh gan trung 1 license cho cung 1 asset']
  }
}

Table MaintenanceTickets {
  Id int [pk, increment]
  AssetId int [not null]
  IssueDescription varchar(1000) [not null]
  Status tinyint [not null, note: '0=Pending,1=Resolved,2=Failed']
  Priority tinyint [not null, note: '0=Low,1=Normal,2=High,3=Urgent; danh sach sap gap nhat truoc']
  TechnicianId int [note: 'nullable - co the chua gan luc moi tao phieu']
  ReportedByUserId int [note: 'nguoi tao phieu (nhan vien bao loi/Admin/Manager); null = phieu cu']
  ReportedDate datetime [not null, default: `now()`]
  ResolvedDate datetime
  Notes varchar(1000)
  Version int [not null, default: 1, note: 'so phien ban - tu tang moi lan sua; client gui lai de chong ghi de (409)']

  indexes {
    AssetId
    TechnicianId
    Status
  }
}

Table MaintenanceTicketHistories {
  Id int [pk, increment]
  TicketId int [not null]
  Action varchar(30) [not null, note: 'Created|Assigned|Reassigned|PriorityChanged|Resolved|Failed|AutoCreated|AutoClosed']
  FromValue varchar(200)
  ToValue varchar(200)
  Reason varchar(1000)
  ActorUserId int
  ActorName varchar(100)
  CreatedAt datetime [not null]

  indexes {
    (TicketId, CreatedAt)
  }
}

Table AssetAllocations {
  Id int [pk, increment]
  AssetId int [not null]
  DepartmentId int [not null]
  RecipientName varchar(100) [not null]
  EmployeeId int [note: 'Nguoi nhan chon tu Employees; RecipientName la ban chup ho ten luc phan bo']
  HandoverReason varchar(255)
  HandoverLocation varchar(200)
  HandoverCondition varchar(50) [not null, note: 'Moi|Tot|Binh thuong|Cu']
  HandedOverByUserId int [note: 'Ben giao tren bien ban = nguoi thuc hien phan bo']
  ReceivedByUserId int [note: 'Ben nhan lai tren bien ban thu hoi']
  AllocatedDate date [not null]
  ReturnedDate date [note: 'null = con dang cap phat']
  HandoverNote varchar(500)
  ReturnCondition tinyint [note: '0=Good,1=Damaged, null khi chưa thu hồi']
  ReturnNote varchar(500) [note: 'Ghi chú khi nhận lại tài sản']
  Status tinyint [not null, note: '0=Allocated,1=Returned']

  indexes {
    AssetId
    DepartmentId
    RecipientPosition varchar(100) [note: 'chuc danh nguoi nhan LUC GIAO (ban chup)']
  ActiveAssetId int [unique, note: '= AssetId khi dang giu, NULL khi da thu hoi; unique => moi tai san toi da 1 phan bo dang hieu luc']
}
}

Table AuditLogs {
  Id bigint [pk, increment]
  UserId int [not null]
  Action varchar(50) [not null, note: 'Create/Update/Delete/Assign/...']
  EntityName varchar(100) [not null]
  EntityId int [not null]
  OldValue text [note: 'chi cac truong thuc su doi (truoc)']
  NewValue text [note: 'chi cac truong thuc su doi (sau)']
  Timestamp datetime [not null, default: `now()`, note: 'UTC, do chinh xac micro-giay']
  Outcome varchar(20) [not null, default: 'Success', note: 'Success | Rejected | Failed']
  StatusCode int
  Message varchar(500) [note: 'ly do tu choi / that bai']
  Detail text [note: 'yeu cau nguoi dung da gui (da che mat khau/token)']
  RequestId varchar(64)
  IpAddress varchar(45)
  ActorName varchar(150) [note: 'ban chup ho ten luc xay ra']
  ActorRole varchar(50) [note: 'ban chup vai tro luc xay ra']
  RowHash varchar(64) [note: 'HMAC-SHA256 noi dung; NULL o ban ghi cu']

  Note: 'Chi-them: trigger trg_AuditLogs_no_update / trg_AuditLogs_no_delete chan UPDATE/DELETE'

  indexes {
    UserId
    Timestamp
    (EntityName, EntityId)
    Outcome
  }
}

