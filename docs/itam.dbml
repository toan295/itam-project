Project EAIMS {
  database_type: 'MySQL'
  Note: 'Enterprise IT Asset & Infrastructure Management System - ERD'
}

Table Roles {
  Id int [pk, increment]
  Name varchar(50) [not null, unique, note: 'Admin IT, Manager, Technician']
}

Table Departments {
  Id int [pk, increment]
  Name varchar(100) [not null]
  Description varchar(255)
}

Table Users {
  Id int [pk, increment]
  FullName varchar(100) [not null]
  Email varchar(150) [not null, unique]
  PasswordHash varchar(255) [not null]
  RoleId int [not null]
  DepartmentId int [not null]
  IsActive boolean [not null, default: true]
  MustChangePassword boolean [not null, default: false, note: 'true khi dang dung mat khau mac dinh do Admin cap/dat lai - bat buoc doi truoc khi dung he thong']
  CreatedAt datetime [not null, default: `now()`]

  indexes {
    RoleId
    DepartmentId
  }
}

Table AssetCategories {
  Id int [pk, increment]
  Name varchar(100) [not null, unique, note: 'may tinh, man hinh, may in, switch/router, thiet bi luu tru...']
}

Table AssetCategoryLifecyclePolicies {
  Id int [pk, increment]
  CategoryId int [not null, unique]
  MaxAgeYears int [not null, note: 'Nguong tuoi toi da theo loai tai san']
  MaxFailureCount int [not null, note: 'Nguong tong so phieu bao tri (moi trang thai) theo loai tai san']

  Note: 'Chi luu nguong override. Loai khong co dong rieng se dung LifecycleOptions trong appsettings.json'
}

Table Assets {
  Id int [pk, increment]
  AssetCode varchar(50) [not null, unique]
  Name varchar(150) [not null]
  CategoryId int [not null]
  SerialNumber varchar(100)
  Specification varchar(500)
  OperatingSystem varchar(100)
  DepartmentId int [not null]
  Status tinyint [not null, note: '0=InUse,1=Maintenance,2=Broken,3=Disposed']
  PurchaseDate date
  WarrantyExpiry date
  CreatedAt datetime [not null, default: `now()`]

  indexes {
    CategoryId
    DepartmentId
    Status
  }
}

Table SoftwareLicenses {
  Id int [pk, increment]
  SoftwareName varchar(150) [not null]
  LicenseKey varchar(255) [not null, unique]
  ExpiryDate date [not null]
  MaxUsage int [not null]
  Notes varchar(500)

  indexes {
    ExpiryDate
  }

  Note: 'CurrentUsage KHONG luu cot rieng - tinh bang COUNT(AssetSoftwareLicenses) de tranh lech du lieu'
}

Table AssetSoftwareLicenses {
  Id int [pk, increment]
  AssetId int [not null]
  LicenseId int [not null]
  AssignedDate date [not null]

  indexes {
    (AssetId, LicenseId) [unique, note: 'tranh gan trung 1 license cho cung 1 asset']
  }
}

Table MaintenanceTickets {
  Id int [pk, increment]
  AssetId int [not null]
  IssueDescription varchar(1000) [not null]
  Status tinyint [not null, note: '0=Pending,1=Resolved,2=Failed']
  Priority tinyint [not null, note: '0=Low,1=Normal,2=High,3=Urgent; danh sach sap gap nhat truoc']
  TechnicianId int [note: 'nullable - co the chua gan luc moi tao phieu']
  ReportedDate datetime [not null, default: `now()`]
  ResolvedDate datetime
  Notes varchar(1000)

  indexes {
    AssetId
    TechnicianId
    Status
  }
}

Table AssetAllocations {
  Id int [pk, increment]
  AssetId int [not null]
  DepartmentId int [not null]
  RecipientName varchar(100) [not null]
  EmployeeId int [note: 'Nguoi nhan chon tu Employees; RecipientName la ban chup ho ten luc phan bo']
  HandoverReason varchar(255)
  HandoverLocation varchar(200)
  HandoverCondition varchar(50) [not null, note: 'Moi|Tot|Binh thuong|Cu']
  HandedOverByUserId int [note: 'Ben giao tren bien ban = nguoi thuc hien phan bo']
  ReceivedByUserId int [note: 'Ben nhan lai tren bien ban thu hoi']
  AllocatedDate date [not null]
  ReturnedDate date [note: 'null = con dang cap phat']
  HandoverNote varchar(500)
  ReturnCondition tinyint [note: '0=Good,1=Damaged, null khi chưa thu hồi']
  ReturnNote varchar(500) [note: 'Ghi chú khi nhận lại tài sản']
  Status tinyint [not null, note: '0=Allocated,1=Returned']

  indexes {
    AssetId
    DepartmentId
  }
}

Table AuditLogs {
  Id bigint [pk, increment]
  UserId int [not null]
  Action varchar(50) [not null, note: 'Create/Update/Delete']
  EntityName varchar(100) [not null]
  EntityId int [not null]
  OldValue text
  NewValue text
  Timestamp datetime [not null, default: `now()`]

  indexes {
    UserId
    Timestamp
  }
}

Table BudgetForecasts {
  Id int [pk, increment]
  Year int [not null]
  DepartmentId int [not null]
  EstimatedReplacementCount int [not null]
  EstimatedBudget decimal(18,2) [not null]
  Notes varchar(500)
  BreakdownJson longtext [note: 'chi tiet theo loai tai san + danh sach tai san de xuat (JSON camelCase), nullable']
  GeneratedAt datetime [note: 'lan tao/cap nhat du bao gan nhat (UTC), nullable']
  IsDeleted boolean [not null, default: false, note: 'xoa mem - chi an tren giao dien, dong van con trong DB']
  DeletedAt datetime [note: 'thoi diem xoa mem (UTC), nullable']

  indexes {
    (Year, DepartmentId) [unique, note: 'moi phong ban chi co 1 du bao/nam']
  }

  Note: 'Uu tien Could - MoSCoW, co the cat giam'
}

Table AssetCategoryReferencePrices {
  CategoryId int [pk, note: 'vua la PK vua la FK - moi loai toi da 1 don gia']
  UnitPrice decimal(18,2) [not null, note: 'VND, > 0']
  IsDeleted boolean [not null, default: false, note: 'xoa mem - nhap lai don gia se khoi phuc']
  DeletedAt datetime [note: 'thoi diem xoa mem (UTC), nullable']

  Note: 'Don gia tham khao theo loai tai san - dung uoc tinh ngan sach thay the (UC-17)'
}

Table SystemSettings {
  Id int [pk, increment]
  Key varchar(100) [not null, unique, note: 'vd: DefaultPassword']
  Value varchar(500) [not null]
  UpdatedAt datetime [not null]

  Note: 'Cau hinh key-value do Admin IT chinh luc chay; hien chi luu mat khau mac dinh (key DefaultPassword)'
}

Table Employees {
  Id int [pk, increment]
  EmployeeCode varchar(20) [not null, unique, note: 'NV0001... sinh tu dong theo Id']
  FullName varchar(100) [not null]
  DepartmentId int [not null]
  Position varchar(100) [note: 'Chuc danh']
  IsActive boolean [not null]
  CreatedAt datetime [not null]

  indexes {
    (DepartmentId, FullName) [unique]
    FullName
  }

  Note: 'Danh muc nhan vien nhan tai san; nguoi nhan khi phan bo phai chon tu day (khong phai tai khoan dang nhap)'
}

Table DisposalStatuses {
  Id int [pk, increment]
  Code varchar(50) [not null, unique, note: 'Inspected|Proposed|Approved|Rejected|Completed (he thong) hoac custom-xxxx (Admin them)']
  Name varchar(100) [not null, unique]
  Description varchar(255)
  Color varchar(20) [not null, note: 'success|warning|danger|info|slate']
  SortOrder int [not null]
  IsSystem boolean [not null, note: 'true = buoc chinh cua luong (khong xoa duoc, Code bat bien); false = trang thai phu do Admin them']

  Note: 'Danh muc trang thai phieu thanh ly, Admin IT them/sua/xoa. 5 dong he thong co san trong migration.'
}

Table DisposalRequests {
  Id int [pk, increment]
  AssetId int [not null]
  StatusId int [not null, note: 'Buoc hien tai cua luong (luon la trang thai he thong)']
  SubStatusId int [note: 'Trang thai phu Admin IT gan thu cong (IsSystem = false)']
  InspectionNote varchar(2000) [not null]
  InspectedByUserId int [not null]
  InspectedAt datetime [not null]
  Reason varchar(1000)
  DisposalMethod varchar(100)
  ProposedByUserId int
  ProposedAt datetime
  ReviewNote varchar(1000)
  ReviewedByUserId int
  ReviewedAt datetime
  CompletionNote varchar(1000)
  CompletedByUserId int
  CompletedAt datetime
  CreatedAt datetime [not null]

  indexes {
    AssetId
    StatusId
    SubStatusId
  }

  Note: 'Luong: Technician kiem tra -> de xuat -> Manager duyet/tu choi -> Admin IT thanh ly -> hoan tat'
}

Table ImportLogs {
  Id int [pk, increment]
  FileName varchar(255) [not null]
  ImportedBy int [not null]
  TotalRows int [not null]
  SuccessRows int [not null]
  FailedRows int [not null]
  ImportedAt datetime [not null, default: `now()`]

  Note: 'Uu tien Should - MoSCoW'
}

Ref: Users.RoleId > Roles.Id
Ref: Users.DepartmentId > Departments.Id
Ref: AssetCategoryLifecyclePolicies.CategoryId > AssetCategories.Id
Ref: Assets.CategoryId > AssetCategories.Id
Ref: Assets.DepartmentId > Departments.Id
Ref: AssetSoftwareLicenses.AssetId > Assets.Id
Ref: AssetSoftwareLicenses.LicenseId > SoftwareLicenses.Id
Ref: MaintenanceTickets.AssetId > Assets.Id
Ref: MaintenanceTickets.TechnicianId > Users.Id
Ref: AssetAllocations.AssetId > Assets.Id
Ref: AssetAllocations.DepartmentId > Departments.Id
Ref: AuditLogs.UserId > Users.Id
Ref: BudgetForecasts.DepartmentId > Departments.Id
Ref: AssetCategoryReferencePrices.CategoryId - AssetCategories.Id
Ref: ImportLogs.ImportedBy > Users.Id

Ref: DisposalRequests.AssetId > Assets.Id
Ref: DisposalRequests.StatusId > DisposalStatuses.Id
Ref: DisposalRequests.SubStatusId > DisposalStatuses.Id
Ref: DisposalRequests.InspectedByUserId > Users.Id
Ref: DisposalRequests.ProposedByUserId > Users.Id
Ref: DisposalRequests.ReviewedByUserId > Users.Id
Ref: DisposalRequests.CompletedByUserId > Users.Id

Ref: Employees.DepartmentId > Departments.Id
Ref: AssetAllocations.EmployeeId > Employees.Id
Ref: AssetAllocations.HandedOverByUserId > Users.Id
Ref: AssetAllocations.ReceivedByUserId > Users.Id
